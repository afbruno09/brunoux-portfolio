---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Resume — Bruno Amorim"
  description="Download Bruno Amorim's resume."
>
  <main>
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <h1>Resume</h1>
          <p>
            Download my latest resume or open it in a new tab.
          </p>
        </div>

        <div class="resume-page-card">
          <div class="resume-page-content">
            <h2>Bruno Amorim — Resume</h2>
            <p>
              Use the options below to download the file or view it directly in
              your browser.
            </p>

            <div class="hero-actions">
              <a
                class="button button-primary"
                href="/files/bruno-amorim-resume.pdf"
                download
              >
                Download Resume
              </a>

              <a
                class="button button-secondary"
                href="/files/bruno-amorim-resume.pdf"
                target="_blank"
                rel="noreferrer"
              >
                Open PDF
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>