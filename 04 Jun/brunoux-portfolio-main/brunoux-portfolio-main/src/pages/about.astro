---
import BaseLayout from "../layouts/BaseLayout.astro";
import { navigationLinks } from "../data/navigation";

const aboutNavigationLinks = navigationLinks.map((link) => {
  if (link.label === "Projects") {
    return { ...link, href: "/#projects" };
  }

  return link;
});
---

<BaseLayout title="About | Bruno Amorim">
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="site-logo">Bruno Amorim</a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="menu-toggle-line"></span>
        <span class="menu-toggle-line"></span>
      </button>

      <nav class="desktop-nav" aria-label="Main navigation">
        <ul>
          {aboutNavigationLinks.map((link) => (
            <li>
              {link.label === "Resume" ? (
                <button type="button" class="nav-link-button" data-open-resume>
                  {link.label}
                </button>
              ) : link.label === "Contact" ? (
                <button type="button" class="nav-link-button" data-open-contact>
                  {link.label}
                </button>
              ) : (
                <a href={link.href}>{link.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
      <div class="container">
        <div class="mobile-nav-panel">
          <ul>
            {aboutNavigationLinks.map((link) => (
              <li>
                {link.label === "Resume" ? (
                  <button type="button" class="nav-link-button" data-open-resume>
                    {link.label}
                  </button>
                ) : link.label === "Contact" ? (
                  <button type="button" class="nav-link-button" data-open-contact>
                    {link.label}
                  </button>
                ) : (
                  <a href={link.href}>{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main class="about-page">
    <section class="about-hero">
      <video
        class="about-hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source
          src="/videos/about-hero-mobile.mp4"
          type="video/mp4"
          media="(max-width: 767px)"
        />
        <source
          src="/videos/about-hero-desktop.mp4"
          type="video/mp4"
          media="(min-width: 768px)"
        />
      </video>

      <div class="about-hero-overlay"></div>

      <div class="about-hero-content">
        <span class="eyebrow">About</span>

        <h1>Designing digital products with clarity, strategy and purpose.</h1>

        <p>
          I’m Bruno Amorim, a Product Designer focused on useful, scalable and
          human-centered digital experiences.
        </p>

        <div class="about-hero-actions">
          <a href="/#projects" class="hero-pill hero-pill-primary">View selected work</a>
          <button type="button" class="hero-pill hero-pill-secondary" data-open-contact>
            Get in touch
          </button>
        </div>

        <a href="#about-content" class="scroll-cue" aria-label="Scroll to profile">
          <span aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <section id="about-content" class="about-section about-intro">
      <div class="section-label">
        <span>01</span>
        <p>Profile</p>
      </div>

      <div class="section-content">
        <h2>I work across research, strategy, interface design and product thinking.</h2>

        <p>
          Over the past 8+ years, I’ve designed digital products for startups,
          consultancies and large organizations across fintech, healthcare,
          energy, public services, data platforms and emerging technologies.
        </p>

        <p>
          My work usually happens between user needs, business goals and
          technical constraints. I help teams turn complex problems into clear
          flows, structured interfaces and digital products that can evolve over
          time.
        </p>
      </div>
    </section>

    <section class="about-section about-section-muted">
      <div class="section-label">
        <span>02</span>
        <p>Methods</p>
      </div>

      <div class="section-content">
        <h2>A compact toolkit for shaping products from ambiguity to interface.</h2>

        <div class="methods-strip" aria-label="Design methods">
          <span>Research</span>
          <span>UX Strategy</span>
          <span>Product Design</span>
          <span>Design Systems</span>
          <span>Prototyping</span>
          <span>Frontend</span>
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="section-label">
        <span>03</span>
        <p>How I work</p>
      </div>

      <div class="section-content">
        <div class="work-grid">
          <article class="work-card">
            <span>01</span>
            <h3>Understand the problem</h3>
            <p>
              I map context, users, goals and constraints before moving into
              solutions.
            </p>
          </article>

          <article class="work-card">
            <span>02</span>
            <h3>Design with clarity</h3>
            <p>
              I create flows, wireframes and interfaces that reduce friction and
              make decisions easier.
            </p>
          </article>

          <article class="work-card">
            <span>03</span>
            <h3>Prototype and validate</h3>
            <p>
              I use prototypes, feedback and product signals to refine the
              experience before and after delivery.
            </p>
          </article>

          <article class="work-card">
            <span>04</span>
            <h3>Collaborate with teams</h3>
            <p>
              I work closely with product managers, developers and stakeholders
              to keep design decisions feasible and aligned.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section about-section-muted">
      <div class="section-label">
        <span>04</span>
        <p>Experience</p>
      </div>

      <div class="section-content">
        <h2>Selected contexts where I’ve helped teams design better products.</h2>

        <div class="experience-list">
          <a class="experience-item" href="/work/world-bank">
            <div>
              <h3>World Bank / Ministry of Labor</h3>
            </div>
            <span>Labor market intelligence and public employment services</span>
          </a>

          <a class="experience-item" href="/work/comgas">
            <div>
              <h3>Field operations and safety tools</h3>
            </div>
            <span>Mobile workflows, documentation and review dashboards</span>
          </a>

          <a class="experience-item" href="/work/canguru">
            <div>
              <h3>Healthcare and pregnancy support</h3>
            </div>
            <span>Mobile health guidance, tracking and community experience</span>
          </a>

          <article class="experience-item">
            <div>
              <h3>E-commerce</h3>
            </div>
            <span>Shopping experiences, product presentation and clearer purchase flows</span>
          </article>

          <article class="experience-item">
            <div>
              <h3>Startups and early-stage products</h3>
            </div>
            <span>Discovery, MVP design, branding and scalable interface foundations</span>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="section-label">
        <span>05</span>
        <p>Education</p>
      </div>

      <div class="section-content">
        <h2>A background that connects art, design, technology and product strategy.</h2>

        <div class="education-list">
          <article class="education-item">
            <span>Degree</span>
            <h3>Bachelor’s Degree in Arts and Design</h3>
            <p>Federal University of Juiz de Fora — UFJF</p>
          </article>

          <article class="education-item">
            <span>Master’s Degree</span>
            <h3>Master’s student in Intelligence Technologies and Digital Design</h3>
            <p>Pontifical Catholic University of São Paulo — PUC-SP</p>
          </article>

          <article class="education-item">
            <span>Specialization</span>
            <h3>UX Design</h3>
            <p>TERA</p>
          </article>

          <article class="education-item">
            <span>Specialization</span>
            <h3>Digital Product Leadership</h3>
            <p>TERA</p>
          </article>

          <article class="education-item">
            <span>Specialization</span>
            <h3>Service Design</h3>
            <p>Professional certification</p>
          </article>

          <article class="education-item">
            <span>Language Certification</span>
            <h3>English Proficiency — C2</h3>
            <p>Certified professional English proficiency</p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-section about-section-muted about-beyond">
      <div class="section-label">
        <span>06</span>
        <p>Beyond design</p>
      </div>

      <div class="section-content">
        <h2>I’m interested in the intersection between design, technology, behavior and culture.</h2>

        <p>
          My background combines product design, visual systems, research and a
          growing technical interest in front-end development and artificial
          intelligence. I believe designers can contribute more when they
          understand not only the interface, but also the system behind it.
        </p>

        <p>
          This is also why I’m rebuilding my own portfolio in code: to have more
          control over structure, performance, interaction and future evolution.
        </p>
      </div>
    </section>

    <section class="about-cta">
      <div>
        <span class="eyebrow">Let’s talk</span>
        <h2>Available for product design, UX strategy and interface systems.</h2>
        <p>
          I’m open to freelance projects, remote opportunities and collaborations
          where design needs to connect user clarity with business outcomes.
        </p>
      </div>

      <div class="about-cta-actions">
        <button type="button" class="primary-button" data-open-contact>
          Get in touch
        </button>
        <a href="/#projects" class="secondary-button">View work</a>
      </div>
    </section>
  </main>

  <div
    id="contact-modal"
    class="modal"
    hidden
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contact-modal-title"
  >
    <button
      type="button"
      class="modal-overlay"
      aria-label="Close contact modal"
      data-close-contact
    ></button>

    <div class="modal-dialog">
      <button
        type="button"
        class="modal-close"
        aria-label="Close contact modal"
        data-close-contact
      >
        ×
      </button>

      <div class="contact-page-card">
        <div class="contact-page-content">
          <h2 id="contact-modal-title">Let’s talk</h2>
          <p>
            Feel free to reach out for freelance work, remote opportunities or
            design collaborations.
          </p>

          <ul class="contact-list">
            <li>
              <strong>Email:</strong>
              <a href="mailto:contact@brunoux.com">contact@brunoux.com</a>
            </li>
            <li>
              <strong>Phone:</strong>
              <a href="tel:+5511951476087">+55 11 95147-6087</a>
            </li>
            <li>
              <strong>LinkedIn:</strong>
              <a
                href="https://www.linkedin.com/in/bruno-amorimf"
                target="_blank"
                rel="noreferrer"
              >
                linkedin.com/in/bruno-amorimf
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div
    id="resume-modal"
    class="modal"
    hidden
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="resume-modal-title"
  >
    <button
      type="button"
      class="modal-overlay"
      aria-label="Close resume modal"
      data-close-resume
    ></button>

    <div class="modal-dialog">
      <button
        type="button"
        class="modal-close"
        aria-label="Close resume modal"
        data-close-resume
      >
        ×
      </button>

      <div class="resume-page-card">
        <div class="resume-page-content">
          <h2 id="resume-modal-title">Bruno Amorim — Resume</h2>
          <p>
            Use the options below to download the file or view it directly in your browser.
          </p>

          <div class="hero-actions">
            <a
              class="button button-primary"
              href="/files/bruno-amorim-resume.pdf"
              download
            >
              Download Resume
            </a>

            <a
              class="button button-secondary"
              href="/files/bruno-amorim-resume.pdf"
              target="_blank"
              rel="noreferrer"
            >
              Open PDF
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .about-page {
      background: #f7f4ef;
      color: #171717;
    }

    .about-hero {
      position: relative;
      min-height: calc(100vh - 68px);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 96px 24px 72px;
      background: #111;
    }

    .about-hero-video,
    .about-hero-overlay {
      position: absolute;
      inset: 0;
    }

    .about-hero-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: 0;
    }

    .about-hero-overlay {
      z-index: 1;
      background:
        linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.28),
          rgba(0, 0, 0, 0.78)
        );
    }

    .about-hero-content {
      position: relative;
      z-index: 2;
      width: min(100%, 900px);
      color: #fff;
      text-align: center;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 16px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    .about-hero-content h1 {
      max-width: 880px;
      margin: 0 auto 20px;
      font-size: clamp(2.35rem, 6vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.04em;
    }

    .about-hero-content p {
      max-width: 620px;
      margin: 0 auto;
      font-size: clamp(1rem, 2vw, 1.2rem);
      line-height: 1.6;
      opacity: 0.9;
    }

    .about-hero-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 28px;
    }

    .hero-pill,
    .primary-button,
    .secondary-button {
      appearance: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 20px;
      border-radius: 999px;
      border: 1px solid transparent;
      font: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition:
        transform 180ms ease,
        opacity 180ms ease,
        background 180ms ease,
        border-color 180ms ease;
    }

    .hero-pill-primary,
    .primary-button {
      background: #fff;
      color: #171717;
    }

    .hero-pill-secondary,
    .secondary-button {
      background: transparent;
      border-color: rgba(255, 255, 255, 0.32);
      color: #fff;
    }

    .hero-pill:hover,
    .primary-button:hover,
    .secondary-button:hover {
      transform: translateY(-2px);
    }

    .scroll-cue {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-top: 32px;
      border: 1px solid rgba(255, 255, 255, 0.36);
      border-radius: 999px;
      color: #fff;
      text-decoration: none;
      animation: scrollCueFloat 1.6s ease-in-out infinite;
    }

    .scroll-cue span {
      width: 12px;
      height: 12px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: translateY(-2px) rotate(45deg);
    }

    @keyframes scrollCueFloat {
      0%,
      100% {
        transform: translateY(0);
        opacity: 0.72;
      }

      50% {
        transform: translateY(8px);
        opacity: 1;
      }
    }

    .about-section {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 72px 24px;
      border-bottom: 1px solid rgba(23, 23, 23, 0.1);
    }

    .about-section-muted {
      background: rgba(255, 255, 255, 0.36);
    }

    .section-label {
      display: flex;
      gap: 12px;
      align-items: center;
      color: rgba(23, 23, 23, 0.56);
    }

    .section-label span,
    .section-label p {
      margin: 0;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .section-content {
      max-width: 920px;
    }

    .section-content h2 {
      max-width: 840px;
      margin: 0 0 24px;
      font-size: clamp(2rem, 5vw, 4.1rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .section-content p {
      max-width: 720px;
      margin: 0 0 18px;
      color: rgba(23, 23, 23, 0.72);
      font-size: 1rem;
      line-height: 1.75;
    }

    .methods-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }

    .methods-strip span {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 14px;
      border: 1px solid rgba(23, 23, 23, 0.12);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.58);
      color: rgba(23, 23, 23, 0.76);
      font-size: 0.9rem;
      font-weight: 700;
    }

    .work-grid,
    .education-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 16px;
    }

    .work-card,
    .education-item {
      padding: 24px;
      border: 1px solid rgba(23, 23, 23, 0.12);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.5);
    }

    .work-card span,
    .education-item span {
      display: inline-block;
      margin: 0 0 24px;
      color: rgba(23, 23, 23, 0.5);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .work-card h3,
    .education-item h3 {
      margin: 0 0 10px;
      font-size: clamp(1.15rem, 2.5vw, 1.45rem);
      line-height: 1.15;
      letter-spacing: -0.03em;
    }

    .work-card p,
    .education-item p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.65;
    }

    .experience-list {
      display: grid;
      gap: 0;
      margin-top: 32px;
      border-top: 1px solid rgba(23, 23, 23, 0.12);
    }

    .experience-item {
      display: grid;
      gap: 14px;
      padding: 28px 0;
      border-bottom: 1px solid rgba(23, 23, 23, 0.12);
      color: inherit;
      text-decoration: none;
    }

    .experience-item h3 {
      margin: 0;
      font-size: clamp(1.25rem, 3vw, 2rem);
      line-height: 1.1;
      letter-spacing: -0.035em;
    }

    .experience-item span {
      color: rgba(23, 23, 23, 0.68);
      line-height: 1.6;
    }

    a.experience-item:hover h3 {
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 1px;
    }

    .about-cta {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 72px 24px;
      background: #171717;
      color: #fff;
    }

    .about-cta h2 {
      max-width: 820px;
      margin: 0;
      font-size: clamp(2rem, 6vw, 4.2rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .about-cta p {
      max-width: 620px;
      margin: 20px 0 0;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.7;
    }

    .about-cta-actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    @media screen and (max-width: 900px) {
      .about-hero {
        min-height: calc(100vh - 68px);
        padding: 80px 20px 44px;
      }

      .about-hero-content {
        max-width: 360px;
      }

      .about-hero-content h1 {
        font-size: clamp(2rem, 11vw, 3rem);
      }

      .about-hero-actions {
        flex-direction: column;
      }

      .hero-pill {
        width: 100%;
      }

      .about-section,
      .about-cta {
        padding: 64px 20px;
      }
    }

    @media screen and (min-width: 768px) {
      .about-hero {
        padding: 120px 48px 72px;
      }

      .about-section {
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 56px;
        padding: 96px 48px;
      }

      .work-grid,
      .education-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .experience-item {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
        align-items: center;
      }

      .about-cta {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        padding: 96px 48px;
      }

      .about-cta-actions {
        min-width: 220px;
      }
    }

    @media screen and (min-width: 1180px) {
      .about-hero,
      .about-section,
      .about-cta {
        padding-left: 72px;
        padding-right: 72px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .about-hero-video {
        display: none;
      }

      .about-hero {
        background:
          linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.25),
            rgba(0, 0, 0, 0.8)
          ),
          #111;
      }

      .scroll-cue {
        animation: none;
      }

      .hero-pill,
      .primary-button,
      .secondary-button {
        transition: none;
      }

      .hero-pill:hover,
      .primary-button:hover,
      .secondary-button:hover {
        transform: none;
      }
    }
  </style>

  <script is:inline>
    const menuToggle = document.querySelector(".menu-toggle");
    const mobileMenu = document.querySelector("#mobile-menu");
    const mobileMenuLinks = document.querySelectorAll("#mobile-menu a");
    const siteHeader = document.querySelector(".site-header");
    let lastScrollY = window.scrollY;
    const openResumeButtonsInMenu = document.querySelectorAll(
      ".mobile-nav [data-open-resume]"
    );
    const openContactButtonsInMenu = document.querySelectorAll(
      ".mobile-nav [data-open-contact]"
    );

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener("click", () => {
        const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isExpanded));
        menuToggle.setAttribute(
          "aria-label",
          isExpanded ? "Open menu" : "Close menu"
        );
        mobileMenu.hidden = isExpanded;
      });

      mobileMenuLinks.forEach((link) => {
        link.addEventListener("click", () => {
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Open menu");
          mobileMenu.hidden = true;
        });
      });

      openResumeButtonsInMenu.forEach((button) => {
        button.addEventListener("click", () => {
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Open menu");
          mobileMenu.hidden = true;
        });
      });

      openContactButtonsInMenu.forEach((button) => {
        button.addEventListener("click", () => {
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Open menu");
          mobileMenu.hidden = true;
        });
      });
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!siteHeader) return;

        const currentScrollY = window.scrollY;
        const isMenuOpen =
          menuToggle?.getAttribute("aria-expanded") === "true";

        if (isMenuOpen || currentScrollY < 24) {
          siteHeader.classList.remove("header-hidden");
        } else if (currentScrollY > lastScrollY) {
          siteHeader.classList.add("header-hidden");
        } else {
          siteHeader.classList.remove("header-hidden");
        }

        lastScrollY = currentScrollY;
      },
      { passive: true }
    );

    const resumeModal = document.querySelector("#resume-modal");
    const openResumeButtons = document.querySelectorAll("[data-open-resume]");
    const closeResumeButtons = document.querySelectorAll("[data-close-resume]");
    const contactModal = document.querySelector("#contact-modal");
    const openContactButtons = document.querySelectorAll("[data-open-contact]");
    const closeContactButtons = document.querySelectorAll("[data-close-contact]");

    function openResumeModal() {
      if (!resumeModal) return;
      resumeModal.hidden = false;
      resumeModal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");
      document.documentElement.classList.add("modal-open");
    }

    function closeResumeModal() {
      if (!resumeModal) return;
      resumeModal.hidden = true;
      resumeModal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
      document.documentElement.classList.remove("modal-open");
    }

    function openContactModal() {
      if (!contactModal) return;
      contactModal.hidden = false;
      contactModal.setAttribute("aria-hidden", "false");
      document.body.classList.add("modal-open");
      document.documentElement.classList.add("modal-open");
    }

    function closeContactModal() {
      if (!contactModal) return;
      contactModal.hidden = true;
      contactModal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("modal-open");
      document.documentElement.classList.remove("modal-open");
    }

    openResumeButtons.forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openResumeModal();
      });
    });

    closeResumeButtons.forEach((button) => {
      button.addEventListener("click", closeResumeModal);
    });

    openContactButtons.forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openContactModal();
      });
    });

    closeContactButtons.forEach((button) => {
      button.addEventListener("click", closeContactModal);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeResumeModal();
        closeContactModal();
      }
    });
  </script>
</BaseLayout>
