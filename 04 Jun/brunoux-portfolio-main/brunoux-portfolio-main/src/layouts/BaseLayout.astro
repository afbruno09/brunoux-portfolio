---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Bruno Amorim — Product Designer",
  description = "Product Designer focused on UX strategy, interface systems and useful digital products across startups, consultancies and public-service contexts.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <slot />
  </body>
</html>
