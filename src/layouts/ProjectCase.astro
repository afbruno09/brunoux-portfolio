---
import { navigationLinks } from "../data/navigation";

export interface ProjectSection {
  id: string;
  title: string;
  eyebrow?: string;
  layout?: "image-first";
  content?: string[];
  bullets?: string[];
  youtubeUrl?: string;
  image?: {
    src: string;
    alt: string;
    caption?: string;
  };
}

export interface ProjectData {
  title: string;
  client: string;
  year: string;
  role: string;
  duration?: string;
  platform?: string;
  summary: string;
  heroImage?: string;
  heroAlt?: string;
  challenge: string[];
  solution: string[];
  impact: string[];
  metadata?: {
    label: string;
    value: string;
  }[];
  sections?: ProjectSection[];
  nextProject?: {
    title: string;
    href: string;
  };
}

const { project } = Astro.props as { project: ProjectData };

const projectNavigationLinks = navigationLinks.map((link) => {
  if (link.label === "Projects") {
    return { ...link, href: "/#projects" };
  }

  return link;
});
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} • Bruno Amorim</title>
    <meta name="description" content={project.summary} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="site-logo">Bruno Amorim</a>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <span class="menu-toggle-line"></span>
          <span class="menu-toggle-line"></span>
        </button>

        <nav class="desktop-nav" aria-label="Main navigation">
          <ul>
            {projectNavigationLinks.map((link) => (
              <li>
                {link.label === "Resume" ? (
                  <button
                    type="button"
                    class="nav-link-button"
                    data-open-resume
                  >
                    {link.label}
                  </button>
                ) : link.label === "Contact" ? (
                  <button
                    type="button"
                    class="nav-link-button"
                    data-open-contact
                  >
                    {link.label}
                  </button>
                ) : (
                  <a href={link.href}>{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
        <div class="container">
          <div class="mobile-nav-panel">
            <ul>
              {projectNavigationLinks.map((link) => (
                <li>
                  {link.label === "Resume" ? (
                    <button
                      type="button"
                      class="nav-link-button"
                      data-open-resume
                    >
                      {link.label}
                    </button>
                  ) : link.label === "Contact" ? (
                    <button
                      type="button"
                      class="nav-link-button"
                      data-open-contact
                    >
                      {link.label}
                    </button>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="project-page">
      <section class="project-hero">
      <section class="project-hero">
  <div class="container">
    <p class="eyebrow">Case Study</p>

    <h1>{project.title}</h1>

    {project.heroImage && (
      <figure class="hero-media">
       <button
  class="image-trigger"
  type="button"
  data-lightbox-src={project.heroImage}
  data-lightbox-alt={project.heroAlt || project.title}
  aria-label="Open image"
>
  <img src={project.heroImage} alt={project.heroAlt || project.title} />
</button>
      </figure>
    )}

    <p class="lead">{project.summary}</p>

    <div class="meta-grid">
      <div>
        <span>Client</span>
        <strong>{project.client}</strong>
      </div>
      <div>
        <span>Year</span>
        <strong>{project.year}</strong>
      </div>
      <div>
        <span>Role</span>
        <strong>{project.role}</strong>
      </div>
      {project.duration && (
        <div>
          <span>Duration</span>
          <strong>{project.duration}</strong>
        </div>
      )}
      {project.platform && (
        <div>
          <span>Platform</span>
          <strong>{project.platform}</strong>
        </div>
      )}
    </div>
  </div>
</section>

      <section class="project-overview">
        <div class="container two-columns">
          <article class="content-block">
            <p class="section-label">Challenge</p>
            <h2>Context and problem</h2>
            {project.challenge.map((item) => <p>{item}</p>)}
          </article>

          <article class="content-block">
            <p class="section-label">Solution</p>
            <h2>Design approach</h2>
            {project.solution.map((item) => <p>{item}</p>)}
          </article>
        </div>
      </section>

      {project.metadata && project.metadata.length > 0 && (
        <section class="project-facts">
          <div class="container">
            <div class="facts-grid">
              {project.metadata.map((item) => (
                <div class="fact-card">
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {project.sections &&
        project.sections.map((section) => (
          <section class="project-section" id={section.id}>
            <div
              class={`container section-layout ${
                section.youtubeUrl && !section.image ? "section-layout-video" : ""
              } ${
                section.layout === "image-first"
                  ? "section-layout-image-first"
                  : ""
              }`}
            >
              <div class="section-copy">
                <div class="section-copy-header">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  <h2>{section.title}</h2>
                </div>

                <div class="section-copy-body">
                  {section.content?.map((paragraph) => <p>{paragraph}</p>)}

                  {section.bullets && section.bullets.length > 0 && (
                    <ul>
                      {section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>

              {section.youtubeUrl && (
  <div class="video-embed">
    <iframe
      src={section.youtubeUrl}
      title={`${section.title} video`}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
)}

{section.image && (
  <figure class="section-media">
    <button
      class="image-trigger"
      type="button"
      data-lightbox-src={section.image.src}
      data-lightbox-alt={section.image.alt}
      aria-label="Open image"
    >
      <img src={section.image.src} alt={section.image.alt} />
    </button>
    {section.image.caption && <figcaption>{section.image.caption}</figcaption>}
  </figure>
)}
            </div>
          </section>
        ))}

      {project.impact.length > 0 && (
        <section class="project-impact">
          <div class="container">
            <p class="section-label">Outcome</p>
            <h2>Impact and learnings</h2>
            <div class="impact-list">
              {project.impact.map((item) => (
                <div class="impact-card">
                  <p>{item}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="project-cta">
        <div class="container cta-box">
          <div>
            <p class="section-label">Next project</p>
            <h2>Continue exploring</h2>
          </div>

          {project.nextProject ? (
            <a href={project.nextProject.href} class="button-link">
              View next project
            </a>
          ) : (
            <a href="/" class="button-link">Back to Home</a>
          )}
        </div>
      </section>

      <div class="image-lightbox" id="image-lightbox" aria-hidden="true">
  <button class="lightbox-backdrop" type="button" aria-label="Close image"></button>

  <div class="lightbox-content" role="dialog" aria-modal="true" aria-label="Expanded project image">
    <button class="lightbox-close" type="button" aria-label="Close image">
      ×
    </button>
    <img id="lightbox-image" src="" alt="" />
  </div>
</div>

      <div
        id="resume-modal"
        class="modal"
        hidden
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-labelledby="resume-modal-title"
      >
        <button
          type="button"
          class="modal-overlay"
          aria-label="Close resume modal"
          data-close-resume
        ></button>

        <div class="modal-dialog">
          <button
            type="button"
            class="modal-close"
            aria-label="Close resume modal"
            data-close-resume
          >
            ×
          </button>

          <div class="resume-page-card">
            <div class="resume-page-content">
              <h2 id="resume-modal-title">Bruno Amorim — Resume</h2>
              <p>
                Use the options below to download the file or view it directly in your browser.
              </p>

              <div class="hero-actions">
                <a
                  class="button button-primary"
                  href="/files/bruno-amorim-resume.pdf"
                  download
                >
                  Download Resume
                </a>

                <a
                  class="button button-secondary"
                  href="/files/bruno-amorim-resume.pdf"
                  target="_blank"
                  rel="noreferrer"
                >
                  Open PDF
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        id="contact-modal"
        class="modal"
        hidden
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-labelledby="contact-modal-title"
      >
        <button
          type="button"
          class="modal-overlay"
          aria-label="Close contact modal"
          data-close-contact
        ></button>

        <div class="modal-dialog">
          <button
            type="button"
            class="modal-close"
            aria-label="Close contact modal"
            data-close-contact
          >
            ×
          </button>

          <div class="contact-page-card">
            <div class="contact-page-content">
              <h2 id="contact-modal-title">Let’s talk</h2>
              <p>
                Feel free to reach out for freelance work, remote opportunities
                or design collaborations.
              </p>

              <ul class="contact-list">
                <li>
                  <strong>Email:</strong>
                  <a href="mailto:contact@brunoux.com">contact@brunoux.com</a>
                </li>
                <li>
                  <strong>Phone:</strong>
                  <a href="tel:+5511951476087">+55 11 95147-6087</a>
                </li>
                <li>
                  <strong>LinkedIn:</strong>
                  <a
                    href="https://www.linkedin.com/in/bruno-amorimf"
                    target="_blank"
                    rel="noreferrer"
                  >
                    linkedin.com/in/bruno-amorimf
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

    </main>
  </body>
</html>

<style>
  :root {
    --bg: #f5f3ee;
    --surface: #fffdf9;
    --text: #181818;
    --muted: #666156;
    --line: rgba(24, 24, 24, 0.08);
    --accent: #181818;
    --radius: 20px;
    --container: 1120px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Arial, sans-serif;
    line-height: 1.5;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 4px);
  }

  .container {
    width: min(100% - 32px, var(--container));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(245, 243, 238, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: transform 220ms ease;
    will-change: transform;
  }

  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: 24px;
  }

  .site-logo {
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: none;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    cursor: pointer;
  }

  .menu-toggle-line {
    display: block;
    width: 16px;
    height: 2px;
    background: var(--text);
    border-radius: 999px;
    transition: transform 160ms ease;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul,
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav .container {
    padding-top: 12px;
    padding-bottom: 16px;
  }

  .mobile-nav-panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 16px 48px rgba(24, 24, 24, 0.08);
    padding: 10px 16px;
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-nav li:last-child a {
    border-bottom: 0;
  }

  .nav-link-button {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .mobile-nav .nav-link-button {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-weight: 600;
    text-align: left;
  }

  .mobile-nav li:last-child .nav-link-button {
    border-bottom: 0;
  }

  .project-page {
    padding: 28px 0 80px;
  }

  .project-hero,
  .project-overview,
  .project-facts,
  .project-section,
  .project-impact,
  .project-cta {
    margin-top: 28px;
  }

  .project-hero .container,
  .project-overview .container,
  .project-facts .container,
  .project-section .container,
  .project-impact .container,
  .project-cta .container {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }

  .eyebrow,
  .section-label,
  .meta-grid span,
  .fact-card span,
  figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }

  h2 {
    font-size: clamp(1.4rem, 4vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .lead {
    max-width: 780px;
    font-size: 1rem;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .meta-grid,
  .facts-grid,
  .impact-list {
    display: grid;
    gap: 12px;
  }

  .meta-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 24px;
  }

  .meta-grid div,
  .fact-card,
  .impact-card {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.6);
  }

  .meta-grid strong,
  .fact-card strong {
    display: block;
    margin-top: 6px;
    font-size: 0.98rem;
  }

  .hero-media {
  margin: 24px 0;
}

  .section-media {
  margin: 0;
}

.video-embed {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: calc(var(--radius) - 4px);
  background: #000;
}

.video-embed iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

  .two-columns,
  .section-layout {
    display: grid;
    gap: 24px;
  }

  .section-copy-body {
    display: block;
  }

  .section-layout-image-first .section-copy {
    display: contents;
  }

  .section-layout-image-first .section-copy-header {
    order: 1;
  }

  .section-layout-image-first .section-media {
    order: 2;
  }

  .section-layout-image-first .section-copy-body {
    order: 3;
  }

  ul {
    margin: 0;
    padding-left: 20px;
  }

  li + li,
  p + p {
    margin-top: 10px;
  }

  .cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid transparent;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .button-primary {
    background: var(--accent);
    color: #ffffff;
  }

  .button-secondary {
    background: transparent;
    border-color: var(--line);
    color: var(--text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .modal:not([hidden]) {
    display: flex;
  }

  .modal-overlay {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(10, 10, 10, 0.56);
    cursor: pointer;
  }

  .modal-dialog {
    position: relative;
    z-index: 1;
    width: min(100%, 560px);
  }

  .modal-close {
    position: absolute;
    top: -16px;
    right: -16px;
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: #ffffff;
    color: var(--text);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
  }

  .resume-page-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.18);
    padding: 32px;
  }

  .contact-page-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.18);
    padding: 32px;
  }

  .resume-page-content,
  .contact-page-content {
    display: grid;
    gap: 18px;
  }

  .resume-page-content h2,
  .resume-page-content p,
  .contact-page-content h2,
  .contact-page-content p {
    margin: 0;
  }

  .resume-page-content p,
  .contact-page-content p {
    color: var(--muted);
  }

  .contact-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: grid;
    gap: 4px;
  }

  .contact-list a {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  body.modal-open {
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .project-page {
      padding-top: 48px;
    }

    .menu-toggle,
    .mobile-nav {
      display: none;
    }

    .desktop-nav {
      display: block;
    }

    .desktop-nav ul {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .desktop-nav a {
      color: var(--muted);
      font-weight: 600;
      text-decoration: none;
    }

    .desktop-nav .nav-link-button {
      color: var(--muted);
      font-weight: 600;
    }

    .desktop-nav a:hover,
    .desktop-nav .nav-link-button:hover {
      color: var(--text);
    }

    .project-hero .container,
    .project-overview .container,
    .project-facts .container,
    .project-section .container,
    .project-impact .container,
    .project-cta .container {
      padding: 40px;
    }

    .two-columns {
      grid-template-columns: 1fr 1fr;
    }

    .section-layout {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: start;
    }

    .section-layout-video {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
    }

    .section-layout-image-first {
      grid-template-columns: minmax(0, 1fr);
    }

    .section-layout-image-first .section-copy-header {
      max-width: 860px;
      margin: 0 auto;
    }

    .section-layout-image-first .section-media {
      width: min(100%, 760px);
      margin: 0 auto;
    }

    .section-layout-image-first .section-copy-body {
      max-width: 860px;
      margin: 0 auto;
    }

    .facts-grid,
    .impact-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .meta-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .cta-box {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .image-trigger {
  display: block;
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: zoom-in;
}

.image-trigger img {
  transition:
    transform 180ms ease,
    box-shadow 180ms ease;
}

.image-trigger:hover img {
  transform: scale(1.01);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12);
}

.image-lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.image-lightbox[aria-hidden="false"] {
  display: flex;
}

.lightbox-backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  background: rgba(10, 10, 10, 0.78);
  cursor: zoom-out;
}

.lightbox-content {
  position: relative;
  z-index: 1;
  width: min(100%, 1200px);
  max-height: calc(100vh - 48px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lightbox-content img {
  width: auto;
  max-width: 100%;
  max-height: calc(100vh - 48px);
  border-radius: 20px;
  object-fit: contain;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
}

.lightbox-close {
  position: absolute;
  top: -16px;
  right: -16px;
  z-index: 2;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 999px;
  background: #ffffff;
  color: #181818;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
}

body.lightbox-open {
  overflow: hidden;
}

@media (max-width: 767px) {
  .image-lightbox {
    padding: 16px;
  }

  .lightbox-content img {
    border-radius: 14px;
    max-height: calc(100vh - 32px);
  }

  .lightbox-close {
    top: 8px;
    right: 8px;
  }

.video-embed {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: calc(var(--radius) - 4px);
  background: #000;
}



</style>

<script is:inline>
  const menuToggle = document.querySelector(".menu-toggle");
  const mobileMenu = document.querySelector("#mobile-menu");
  const mobileMenuLinks = document.querySelectorAll("#mobile-menu a");
  const siteHeader = document.querySelector(".site-header");
  let lastScrollY = window.scrollY;
  const openResumeButtonsInMenu = document.querySelectorAll(
    ".mobile-nav [data-open-resume]"
  );
  const openContactButtonsInMenu = document.querySelectorAll(
    ".mobile-nav [data-open-contact]"
  );

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener("click", () => {
      const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isExpanded));
      menuToggle.setAttribute(
        "aria-label",
        isExpanded ? "Open menu" : "Close menu"
      );
      mobileMenu.hidden = isExpanded;
    });

    mobileMenuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open menu");
        mobileMenu.hidden = true;
      });
    });

    openResumeButtonsInMenu.forEach((button) => {
      button.addEventListener("click", () => {
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open menu");
        mobileMenu.hidden = true;
      });
    });

    openContactButtonsInMenu.forEach((button) => {
      button.addEventListener("click", () => {
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open menu");
        mobileMenu.hidden = true;
      });
    });
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!siteHeader) return;

      const currentScrollY = window.scrollY;
      const isMenuOpen =
        menuToggle?.getAttribute("aria-expanded") === "true";

      if (isMenuOpen || currentScrollY < 24) {
        siteHeader.classList.remove("header-hidden");
      } else if (currentScrollY > lastScrollY) {
        siteHeader.classList.add("header-hidden");
      } else {
        siteHeader.classList.remove("header-hidden");
      }

      lastScrollY = currentScrollY;
    },
    { passive: true }
  );

  const resumeModal = document.querySelector("#resume-modal");
  const openResumeButtons = document.querySelectorAll("[data-open-resume]");
  const closeResumeButtons = document.querySelectorAll("[data-close-resume]");
  const contactModal = document.querySelector("#contact-modal");
  const openContactButtons = document.querySelectorAll("[data-open-contact]");
  const closeContactButtons = document.querySelectorAll("[data-close-contact]");

  function openResumeModal() {
    if (!resumeModal) return;
    resumeModal.hidden = false;
    resumeModal.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");
  }

  function closeResumeModal() {
    if (!resumeModal) return;
    resumeModal.hidden = true;
    resumeModal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("modal-open");
  }

  function openContactModal() {
    if (!contactModal) return;
    contactModal.hidden = false;
    contactModal.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");
  }

  function closeContactModal() {
    if (!contactModal) return;
    contactModal.hidden = true;
    contactModal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("modal-open");
  }

  openResumeButtons.forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      openResumeModal();
    });
  });

  closeResumeButtons.forEach((button) => {
    button.addEventListener("click", closeResumeModal);
  });

  openContactButtons.forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      openContactModal();
    });
  });

  closeContactButtons.forEach((button) => {
    button.addEventListener("click", closeContactModal);
  });

  const lightbox = document.querySelector("#image-lightbox");
  const lightboxImage = document.querySelector("#lightbox-image");
  const triggers = document.querySelectorAll("[data-lightbox-src]");
  const closeButtons = document.querySelectorAll(
    ".lightbox-close, .lightbox-backdrop"
  );

  function openLightbox(src, alt) {
    if (!lightbox || !lightboxImage) return;

    lightboxImage.src = src;
    lightboxImage.alt = alt || "";
    lightbox.setAttribute("aria-hidden", "false");
    document.body.classList.add("lightbox-open");
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImage) return;

    lightbox.setAttribute("aria-hidden", "true");
    lightboxImage.src = "";
    lightboxImage.alt = "";
    document.body.classList.remove("lightbox-open");
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const src = trigger.getAttribute("data-lightbox-src");
      const alt = trigger.getAttribute("data-lightbox-alt");

      if (src) {
        openLightbox(src, alt);
      }
    });
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeLightbox);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeResumeModal();
      closeContactModal();
      closeLightbox();
    }
  });
</script>
