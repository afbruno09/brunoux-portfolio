---
import { navigationLinks } from "../data/navigation";

export interface ProjectSection {
  id: string;
  title: string;
  eyebrow?: string;
  layout?: "image-first" | "text-first";
  imageColumns?: 1 | 2 | 3;
  imageAlign?: "center";
  kind?: "stats" | "journey" | "flow" | "scan" | "embed" | "checklist" | "diagram" | "cards" | "brand" | "journey-map";
  journeyFlows?: { name: string; role?: string; steps: (string | { text: string; key?: boolean })[] }[];
  keyLabel?: string;
  brandLogos?: { src: string; alt: string; background: string }[];
  brandColors?: { name: string; hex: string }[];
  brandFonts?: { role: string; family: string; sample: string; tone?: "text" }[];
  bare?: boolean;
  brandFontsHref?: string;
  content?: string[];
  bullets?: string[];
  note?: string;
  youtubeUrl?: string;
  embedUrl?: string;
  embedTitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  checklistItems?: (string | { title: string; body?: string })[];
  cards?: { title: string; body: string; image?: { src: string; alt: string } }[];
  tags?: string[];
  statsSource?: string;
  diagramEyebrow?: string;
  diagramTitle?: string;
  diagramSubtitle?: string;
  diagramCenter?: { title: string; subtitle?: string };
  diagramNodes?: { title: string; body?: string }[];
  diagramJourneyLabel?: string;
  diagramJourneySteps?: string[];
  image?: {
    src: string;
    alt: string;
    caption?: string;
  };
  imageMaxWidth?: string;
  stats?: { value: string; label: string }[];
  statsNote?: string;
  scanItems?: { title: string; body?: string; bullets?: string[] }[];
  journeyStages?: { stage: string; description: string }[];
  flowIntro?: {
    image: { src: string; alt: string };
    caption?: string;
  };
  flowLabel?: string;
  images?: { src: string; alt: string; caption?: string }[];
  flowSteps?: {
    image: { src: string; alt: string };
    caption: string;
  }[];
}

export interface ProjectData {
  title: string;
  client: string;
  year: string;
  role: string;
  platform?: string;
  summary: string;
  heroImage?: string;
  heroAlt?: string;
  accentColor?: string;
  heroEyebrow?: string;
  heroTone?: "accent";
  heroImageMaxWidth?: string;
  hideOverview?: boolean;
  challenge: string[];
  solution: string[];
  metadata?: {
    label: string;
    value: string;
  }[];
  sections?: ProjectSection[];
  nextProject?: {
    title: string;
    href: string;
  };
}

const { project } = Astro.props as { project: ProjectData };

const projectNavigationLinks = navigationLinks.map((link) => {
  if (link.label === "Projects") {
    return { ...link, href: "/#projects" };
  }

  return link;
});

const allSections = project.sections ?? [];
const scanSection = allSections.find((s) => s.kind === "scan");
const bodySections = allSections.filter((s) => s.kind !== "scan");
const brandFontsHref = allSections.find((s) => s.kind === "brand")?.brandFontsHref;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} • Bruno Amorim</title>
    <meta name="description" content={project.summary} />
    {brandFontsHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={brandFontsHref} />
      </>
    )}
  </head>
  <body style={project.accentColor ? `--accent: ${project.accentColor};` : undefined}>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="site-logo">Bruno Amorim</a>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <span class="menu-toggle-line"></span>
          <span class="menu-toggle-line"></span>
        </button>

        <nav class="desktop-nav" aria-label="Main navigation">
          <ul>
            {projectNavigationLinks.map((link) => (
              <li>
                {link.label === "Resume" ? (
                  <button
                    type="button"
                    class="nav-link-button"
                    data-open-resume
                  >
                    {link.label}
                  </button>
                ) : link.label === "Contact" ? (
                  <button
                    type="button"
                    class="nav-link-button"
                    data-open-contact
                  >
                    {link.label}
                  </button>
                ) : (
                  <a href={link.href}>{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
        <div class="container">
          <div class="mobile-nav-panel">
            <ul>
              {projectNavigationLinks.map((link) => (
                <li>
                  {link.label === "Resume" ? (
                    <button
                      type="button"
                      class="nav-link-button"
                      data-open-resume
                    >
                      {link.label}
                    </button>
                  ) : link.label === "Contact" ? (
                    <button
                      type="button"
                      class="nav-link-button"
                      data-open-contact
                    >
                      {link.label}
                    </button>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="project-page" id="top">
      <section class={`project-hero ${project.heroTone === "accent" ? "project-hero-accent" : ""}`}>
  <div class="container">
    <p class="eyebrow">{project.heroEyebrow || "Case Study"}</p>

    <h1>{project.title}</h1>

    {project.heroImage && (
      <figure
        class="hero-media"
        style={
          project.heroImageMaxWidth
            ? `max-width:${project.heroImageMaxWidth}; margin-left:auto; margin-right:auto;`
            : undefined
        }
      >
       <button
  class="image-trigger"
  type="button"
  data-lightbox-src={project.heroImage}
  data-lightbox-alt={project.heroAlt || project.title}
  aria-label="Open image"
>
  <img src={project.heroImage} alt={project.heroAlt || project.title} />
</button>
      </figure>
    )}

    <p class="lead">{project.summary}</p>

    <div class="meta-grid">
      <div>
        <span>Client</span>
        <strong>{project.client}</strong>
      </div>
      <div>
        <span>Year</span>
        <strong>{project.year}</strong>
      </div>
      <div>
        <span>Role</span>
        <strong>{project.role}</strong>
      </div>
      {project.platform && (
        <div>
          <span>Platform</span>
          <strong>{project.platform}</strong>
        </div>
      )}
    </div>
  </div>
</section>

      {scanSection && (
        <section class="project-section scan-section" id={scanSection.id}>
          <div class="container">
            {scanSection.eyebrow && (
              <p class="section-label scan-label">{scanSection.eyebrow}</p>
            )}
            <div class="scan-grid">
              {scanSection.scanItems?.map((item) => (
                <div class="scan-item">
                  <h4>{item.title}</h4>
                  {item.body && <p>{item.body}</p>}
                  {item.bullets && item.bullets.length > 0 && (
                    <div class="scan-bullets">
                      {item.bullets.map((bullet) => (
                        <p><span class="scan-bullet-arrow" aria-hidden="true">→</span>{bullet}</p>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {!project.hideOverview && (
        <section class="project-overview">
          <div class="container two-columns">
            <article class="content-block">
              <p class="section-label">Challenge</p>
              <h2>Context and problem</h2>
              {project.challenge.map((item) => <p>{item}</p>)}
            </article>

            <article class="content-block">
              <p class="section-label">Solution</p>
              <h2>Design approach</h2>
              {project.solution.map((item) => <p>{item}</p>)}
            </article>
          </div>
        </section>
      )}

      {project.metadata && project.metadata.length > 0 && (
        <section class="project-facts">
          <div class="container">
            <div class="facts-grid">
              {project.metadata.map((item) => (
                <div class="fact-card">
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {bodySections.length > 0 &&
        bodySections.map((section) => {
          if (section.kind === "stats") {
            return (
              <section class="project-section stats-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && (
                    <p class="section-label stats-label">{section.eyebrow}</p>
                  )}
                  {section.title && <h2 class="stats-title">{section.title}</h2>}
                  {section.content?.map((paragraph) => <p class="stats-intro">{paragraph}</p>)}
                  <div class="stats-grid">
                    {section.stats?.map((stat) => (
                      <div class="stat-card">
                        <strong class="stat-value">{stat.value}</strong>
                        <span class="stat-label">{stat.label}</span>
                      </div>
                    ))}
                  </div>
                  {section.statsSource && (
                    <p class="stats-source">{section.statsSource}</p>
                  )}
                  {section.statsNote && (
                    <p class="stats-note">{section.statsNote}</p>
                  )}
                  {section.image && (
                    <figure
                      class="section-media stats-media"
                      style={
                        section.imageMaxWidth
                          ? `max-width:${section.imageMaxWidth};`
                          : undefined
                      }
                    >
                      <button
                        class="image-trigger"
                        type="button"
                        data-lightbox-src={section.image.src}
                        data-lightbox-alt={section.image.alt}
                        aria-label="Open image"
                      >
                        <img src={section.image.src} alt={section.image.alt} />
                      </button>
                      {section.image.caption && <figcaption>{section.image.caption}</figcaption>}
                    </figure>
                  )}
                </div>
              </section>
            );
          }

          if (section.kind === "journey") {
            return (
              <section class="project-section journey-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  <h2>{section.title}</h2>

                  <div class="section-copy-body journey-copy">
                    {section.content?.map((paragraph) => <p>{paragraph}</p>)}
                  </div>

                  {section.journeyStages && section.journeyStages.length > 0 && (
                    <div class="journey-grid">
                      {section.journeyStages.map((item) => (
                        <div class="journey-col">
                          <h5>{item.stage}</h5>
                          <p>{item.description}</p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </section>
            );
          }

          if (section.kind === "flow") {
            return (
              <section class="project-section flow-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  <h2>{section.title}</h2>

                  <div class="section-copy-body">
                    {section.content?.map((paragraph) => <p>{paragraph}</p>)}
                  </div>

                  {section.flowIntro && (
                    <figure
                      class="flow-intro-media"
                      style={
                        section.imageMaxWidth
                          ? `max-width:${section.imageMaxWidth}; margin-left:auto; margin-right:auto;`
                          : undefined
                      }
                    >
                      <button
                        class="image-trigger"
                        type="button"
                        data-lightbox-src={section.flowIntro.image.src}
                        data-lightbox-alt={section.flowIntro.image.alt}
                        aria-label="Open image"
                      >
                        <img
                          src={section.flowIntro.image.src}
                          alt={section.flowIntro.image.alt}
                        />
                      </button>
                      {section.flowIntro.caption && (
                        <figcaption>{section.flowIntro.caption}</figcaption>
                      )}
                    </figure>
                  )}

                  {section.flowLabel && (
                    <p class="section-label flow-row-label">{section.flowLabel}</p>
                  )}

                  {section.flowSteps && section.flowSteps.length > 0 && (
                    <div class="flow-row">
                      {section.flowSteps.map((step, i) => (
                        <>
                          <figure class="flow-step">
                            <span class="flow-step-index">{i + 1}</span>
                            <button
                              class="image-trigger"
                              type="button"
                              data-lightbox-src={step.image.src}
                              data-lightbox-alt={step.image.alt}
                              aria-label="Open image"
                            >
                              <img src={step.image.src} alt={step.image.alt} />
                            </button>
                            <figcaption>{step.caption}</figcaption>
                          </figure>
                          {i < (section.flowSteps?.length ?? 0) - 1 && (
                            <span class="flow-arrow" aria-hidden="true">→</span>
                          )}
                        </>
                      ))}
                    </div>
                  )}
                </div>
              </section>
            );
          }

          if (section.kind === "embed") {
            return (
              <section class="project-section embed-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label embed-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  {section.content?.map((paragraph) => <p>{paragraph}</p>)}

                  <div class="embed-box">
                    {section.embedUrl ? (
                      <iframe
                        src={section.embedUrl}
                        title={section.embedTitle || "Figma prototype"}
                        allowfullscreen
                        loading="lazy"
                      ></iframe>
                    ) : (
                      <div class="embed-placeholder">
                        <span>Figma preview</span>
                      </div>
                    )}
                  </div>

                  {section.ctaHref && (
                    <a
                      class="button button-primary embed-cta"
                      href={section.ctaHref}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {section.ctaLabel || "Open the Figma file ↗"}
                    </a>
                  )}

                  {section.note && <p class="note-box">{section.note}</p>}
                </div>
              </section>
            );
          }

          if (section.kind === "diagram") {
            const nodes = section.diagramNodes ?? [];
            const positions = ["tl", "tr", "bl", "br"];
            return (
              <section class="project-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  {section.content?.map((paragraph) => <p class="section-copy-body">{paragraph}</p>)}

                  <div class="arch-card">
                    {section.diagramEyebrow && <p class="arch-label">{section.diagramEyebrow}</p>}
                    {section.diagramTitle && <h3 class="arch-title">{section.diagramTitle}</h3>}
                    {section.diagramSubtitle && <p class="arch-subtitle">{section.diagramSubtitle}</p>}

                    <div class="arch-diagram">
                      <svg class="arch-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                        <line x1="18" y1="18" x2="50" y2="50" />
                        <line x1="82" y1="18" x2="50" y2="50" />
                        <line x1="18" y1="82" x2="50" y2="50" />
                        <line x1="82" y1="82" x2="50" y2="50" />
                      </svg>

                      {nodes.map((node, i) => (
                        <div class={`arch-node arch-node-${positions[i] || "tl"}`}>
                          <h4>{node.title}</h4>
                          {node.body && <p>{node.body}</p>}
                        </div>
                      ))}

                      {section.diagramCenter && (
                        <div class="arch-center">
                          <strong>{section.diagramCenter.title}</strong>
                          {section.diagramCenter.subtitle && <span>{section.diagramCenter.subtitle}</span>}
                        </div>
                      )}
                    </div>

                    {section.diagramJourneySteps && section.diagramJourneySteps.length > 0 && (
                      <p class="arch-journey">
                        {section.diagramJourneyLabel && <strong>{section.diagramJourneyLabel} </strong>}
                        {section.diagramJourneySteps.map((step, i) => (
                          <>
                            <span>{step}</span>
                            {i < (section.diagramJourneySteps?.length ?? 0) - 1 && (
                              <span class="arch-journey-arrow" aria-hidden="true">→</span>
                            )}
                          </>
                        ))}
                      </p>
                    )}
                  </div>
                </div>
              </section>
            );
          }

          if (section.kind === "checklist") {
            return (
              <section class="project-section checklist-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  {section.content?.map((paragraph) => <p class="section-copy-body">{paragraph}</p>)}
                  <div class="checklist-grid">
                    {section.checklistItems?.map((item) => (
                      <div class="check-card">
                        <span class="check-mark" aria-hidden="true">✓</span>
                        {typeof item === "string" ? (
                          <p>{item}</p>
                        ) : (
                          <div class="check-copy">
                            <p class="check-title">{item.title}</p>
                            {item.body && <p class="check-body">{item.body}</p>}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            );
          }

          if (section.kind === "journey-map") {
            return (
              <section class="project-section journey-map-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  <div class="section-copy-body journey-map-copy">
                    {section.content?.map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                  {section.journeyFlows?.map((flow) => (
                    <div class="journey-map">
                      <h3 class="journey-map-name">
                        {flow.name}
                        {flow.role && <span>{flow.role}</span>}
                      </h3>
                      <ol class="journey-map-steps">
                        {flow.steps.map((step) => {
                          const item = typeof step === "string" ? { text: step, key: false } : step;
                          return (
                            <li class={`journey-map-step ${item.key ? "journey-map-step-key" : ""}`}>
                              <p>{item.text}</p>
                              {item.key && section.keyLabel && (
                                <span class="journey-map-key-label">{section.keyLabel}</span>
                              )}
                            </li>
                          );
                        })}
                      </ol>
                    </div>
                  ))}
                </div>
              </section>
            );
          }

          if (section.kind === "brand") {
            return (
              <section class="project-section brand-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  <div class="section-copy-body brand-copy">
                    {section.content?.map((paragraph) => <p>{paragraph}</p>)}
                  </div>

                  {section.brandLogos && section.brandLogos.length > 0 && (
                    <div class="brand-logos">
                      {section.brandLogos.map((logo) => (
                        <div class="brand-logo-tile" style={`background:${logo.background};`}>
                          <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
                        </div>
                      ))}
                    </div>
                  )}

                  <div class="brand-specs">
                    {section.brandColors && section.brandColors.length > 0 && (
                      <ul class="brand-swatches" aria-label="Color palette">
                        {section.brandColors.map((color) => (
                          <li class="brand-swatch">
                            <span class="brand-swatch-chip" style={`background:${color.hex};`}></span>
                            <strong>{color.name}</strong>
                            <code>{color.hex}</code>
                          </li>
                        ))}
                      </ul>
                    )}

                    {section.brandFonts && section.brandFonts.length > 0 && (
                      <div class="brand-fonts">
                        {section.brandFonts.map((font) => (
                          <div class="brand-font">
                            <p class="brand-font-meta">
                              <span>{font.role}</span>
                              <strong>{font.family}</strong>
                            </p>
                            <p class={`brand-font-sample ${font.tone === "text" ? "brand-font-sample-text" : ""}`} style={`font-family:'${font.family}', sans-serif;`}>
                              {font.sample}
                            </p>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </section>
            );
          }

          if (section.kind === "cards") {
            return (
              <section class="project-section cards-section" id={section.id}>
                <div class="container">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  {section.content?.map((paragraph) => <p class="section-copy-body">{paragraph}</p>)}
                  <div class="card-grid">
                    {section.cards?.map((card) => (
                      <div class="info-card">
                        {card.image && (
                          <button
                            class="image-trigger info-card-media"
                            type="button"
                            data-lightbox-src={card.image.src}
                            data-lightbox-alt={card.image.alt}
                            aria-label="Open image"
                          >
                            <img src={card.image.src} alt={card.image.alt} />
                          </button>
                        )}
                        <h4>{card.title}</h4>
                        <p>{card.body}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </section>
            );
          }

          return (
          <section class={`project-section ${section.bare ? "project-section-bare" : ""}`} id={section.id}>
            <div
              class={`container section-layout ${
                section.youtubeUrl && !section.image ? "section-layout-video" : ""
              } ${
                section.layout === "image-first"
                  ? "section-layout-image-first"
                  : ""
              } ${
                section.layout === "text-first"
                  ? "section-layout-text-first"
                  : ""
              } ${section.imageAlign === "center" ? "section-layout-center" : ""}`}
            >
              <div class="section-copy">
                <div class="section-copy-header">
                  {section.eyebrow && <p class="section-label">{section.eyebrow}</p>}
                  <h2>{section.title}</h2>
                </div>

                <div class="section-copy-body">
                  {section.content?.map((paragraph) => <p>{paragraph}</p>)}

                  {section.bullets && section.bullets.length > 0 && (
                    <ul>
                      {section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}

                  {section.tags && section.tags.length > 0 && (
                    <ul class="tag-row">
                      {section.tags.map((tag) => (
                        <li class="tag">{tag}</li>
                      ))}
                    </ul>
                  )}

                  {section.note && <p class="note-box">{section.note}</p>}
                </div>
              </div>

              {section.youtubeUrl && (
  <div class="video-embed">
    <iframe
      src={section.youtubeUrl}
      title={`${section.title} video`}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
)}

{section.image && (
  <figure
    class="section-media"
    style={
      section.imageMaxWidth
        ? `max-width:${section.imageMaxWidth}; margin-left:auto; margin-right:auto;`
        : undefined
    }
  >
    <button
      class="image-trigger"
      type="button"
      data-lightbox-src={section.image.src}
      data-lightbox-alt={section.image.alt}
      aria-label="Open image"
    >
      <img src={section.image.src} alt={section.image.alt} loading="lazy" decoding="async" />
    </button>
    {section.image.caption && <figcaption>{section.image.caption}</figcaption>}
  </figure>
)}

{section.images && section.images.length > 0 && (
