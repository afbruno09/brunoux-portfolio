---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const projectPreviews = Object.fromEntries(
  projects.map(({ slug, title, category, thumbnail }) => [
    `/work/${slug}`,
    { title, category, image: thumbnail },
  ])
);

const chatNavigationLinks = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/#projects" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout
  title="Bruno Amorim Portfolio Assistant"
  description="An AI-powered way to explore Bruno Amorim's UX/Product Design work, selected projects, experience, resume, and collaboration options."
  image="https://www.brunoux.com/images/portfolio-assistant-orb-preview.png"
>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="site-logo">Bruno Amorim</a>

      <div class="header-actions">
        <nav class="desktop-nav" aria-label="Chat page navigation">
          <ul>
            {chatNavigationLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="language-switch" role="group" aria-label="Language" data-language-switch>
          <button
            type="button"
            data-language-option="en"
            aria-pressed="true"
            aria-label="English"
            lang="en"
          >
            EN
          </button>
          <button
            type="button"
            data-language-option="pt"
            aria-pressed="false"
            aria-label="Português"
            lang="pt-BR"
          >
            PT
          </button>
        </div>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <span class="menu-toggle-line"></span>
          <span class="menu-toggle-line"></span>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
      <div class="container">
        <div class="mobile-nav-panel">
          <ul>
            {chatNavigationLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero section chat-page-hero" data-chat-page>
      <div class="container hero-inner">
        <div class="hero-content">
          <p class="hero-name" data-i18n="hero.kicker">AI portfolio guide</p>
          <h1 data-i18n="hero.title">Meet Bruno's Portfolio Assistant</h1>
          <div
            class="hero-orb"
            data-hero-orb
            aria-hidden="true"
          >
            <div class="hero-orb-glow" aria-hidden="true"></div>
            <div class="hero-media">
              <dotlottie-player
                src="/animations/orb.lottie"
                background="transparent"
                speed="1"
                loop
                data-hero-orb-player
              ></dotlottie-player>
            </div>
          </div>

          <p class="hero-chat-intro" data-hero-chat-intro data-i18n="chat.initial">
            Hi, I can help you understand Bruno's projects, experience, and
            which case best matches what you are looking for.
          </p>

          <div class="hero-chat">
            <button
              class="hero-chat-reset"
              type="button"
              data-chat-reset
              data-i18n="chat.reset"
              hidden
            >
              New conversation
            </button>

            <div
              class="hero-chat-history"
              data-hero-chat-history
              aria-live="polite"
            >
            </div>

            <div class="hero-chat-composer">
              <form class="hero-chat-form" data-hero-chat-form>
                <label class="visually-hidden" for="hero-chat-input">
                  Ask about Bruno's work and experiences
                </label>
                <input
                  id="hero-chat-input"
                  name="question"
                  type="text"
                  placeholder="Ask about Bruno's work"
                  data-i18n-placeholder="chat.placeholder"
                  autocomplete="off"
                  maxlength="1000"
                  enterkeyhint="send"
                />
                <button
                  class="button button-primary"
                  type="submit"
                  data-chat-submit
                  data-i18n="chat.ask"
                >
                  Ask
                </button>
              </form>

              <div class="hero-chat-suggestions" aria-label="Suggested questions">
                <button
                  type="button"
                  data-chat-suggestion="Which project best shows UX strategy?"
                  data-chat-suggestion-en="Which project best shows UX strategy?"
                  data-chat-suggestion-pt="Qual projeto mostra melhor UX Strategy?"
                  data-i18n="chat.suggestionStrategy"
                >
                  UX Strategy
                </button>
                <button
                  type="button"
                  data-chat-suggestion="Does Bruno have experience with complex products?"
                  data-chat-suggestion-en="Does Bruno have experience with complex products?"
                  data-chat-suggestion-pt="Bruno tem experiência com produtos complexos?"
                  data-i18n="chat.suggestionComplex"
                >
                  Complex products
                </button>
                <button
                  type="button"
                  data-chat-suggestion="Why hire Bruno?"
                  data-chat-suggestion-en="Why hire Bruno?"
                  data-chat-suggestion-pt="Por que contratar o Bruno?"
                  data-i18n="chat.suggestionHire"
                >
                  Why hire Bruno?
                </button>
                <button
                  type="button"
                  data-chat-suggestion="Show me a case with impact"
                  data-chat-suggestion-en="Show me a case with impact"
                  data-chat-suggestion-pt="Mostre um case com impacto"
                  data-i18n="chat.suggestionImpact"
                >
                  Biggest impact
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import "@dotlottie/player-component";
  </script>

  <script is:inline define:vars={{ projectPreviews }}>
    const heroChatForm = document.querySelector("[data-hero-chat-form]");
    const heroChatInput = document.querySelector("#hero-chat-input");
    const heroChatHistory = document.querySelector("[data-hero-chat-history]");
    const heroOrb = document.querySelector("[data-hero-orb]");
    const heroChatIntro = document.querySelector("[data-hero-chat-intro]");
    const heroChatSubmit = document.querySelector("[data-chat-submit]");
    const heroChatSuggestions = document.querySelectorAll(
      "[data-chat-suggestion]"
    );
    const languageSwitch = document.querySelector("[data-language-switch]");
    const languageOptions = document.querySelectorAll("[data-language-option]");
    const chatPage = document.querySelector("[data-chat-page]");
    const chatReset = document.querySelector("[data-chat-reset]");
    const menuToggle = document.querySelector(".menu-toggle");
    const mobileMenu = document.querySelector("#mobile-menu");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const hasFinePointer = window.matchMedia("(pointer: fine)").matches;

    if (!prefersReducedMotion) {
      document
        .querySelector("[data-hero-orb-player]")
        ?.setAttribute("autoplay", "");
    }

    const translations = {
      en: {
        "hero.kicker": "AI portfolio guide",
        "hero.title": "Meet Bruno's Portfolio Assistant",
        "chat.assistantName": "Bruno's Portfolio Assistant",
        "chat.initial":
          "Hi, I can help you understand Bruno's projects, experience, and which case best matches what you are looking for.",
        "chat.placeholder": "Ask about Bruno's work",
        "chat.ask": "Ask",
        "chat.loading": "Looking through Bruno's work",
        "chat.error":
          "I couldn't answer that right now. Please try again, or contact Bruno directly for more context.",
        "chat.you": "You",
        "menu.open": "Open menu",
        "menu.close": "Close menu",
        "chat.suggestionStrategy": "UX Strategy",
        "chat.suggestionComplex": "Complex products",
        "chat.suggestionHire": "Why hire Bruno?",
        "chat.suggestionImpact": "Biggest impact",
        "chat.reset": "New conversation",
        "chat.emailBruno": "Email Bruno",
        "chat.viewWork": "View selected work",
        "language.label": "Language",
      },
      pt: {
        "hero.kicker": "Guia do portfolio com IA",
        "hero.title": "Converse com o portfolio do Bruno",
        "chat.assistantName": "Assistente do Portfolio do Bruno",
        "chat.initial":
          "Oi, eu posso te ajudar a entender os projetos do Bruno, sua experiência e qual case combina melhor com o que você procura.",
        "chat.placeholder": "Faça sua pergunta",
        "chat.ask": "Perguntar",
        "chat.loading": "Organizando a resposta",
        "chat.error":
          "Não consegui responder agora. Tente novamente ou entre em contato com o Bruno para mais contexto.",
        "chat.you": "Você",
        "menu.open": "Abrir menu",
        "menu.close": "Fechar menu",
        "chat.suggestionStrategy": "UX Strategy",
        "chat.suggestionComplex": "Produtos complexos",
        "chat.suggestionHire": "Por que contratar?",
        "chat.suggestionImpact": "Maior impacto",
        "chat.reset": "Nova conversa",
        "chat.emailBruno": "Enviar e-mail ao Bruno",
        "chat.viewWork": "Ver trabalhos selecionados",
        "language.label": "Idioma",
      },
    };

    function getCurrentLanguage() {
      return localStorage.getItem("site-language") === "pt" ? "pt" : "en";
    }

    function translate(key) {
      const language = getCurrentLanguage();
      return translations[language]?.[key] ?? translations.en[key] ?? key;
    }

    function applyLanguage(requestedLanguage) {
      const language = requestedLanguage === "pt" ? "pt" : "en";
      const dictionary = translations[language] ?? translations.en;

      document.documentElement.lang = language === "pt" ? "pt-BR" : "en";

      document.querySelectorAll("[data-i18n]").forEach((element) => {
        const key = element.getAttribute("data-i18n");
        if (key && dictionary[key]) {
          element.textContent = dictionary[key];
        }
      });

      document.querySelectorAll("[data-i18n-placeholder]").forEach((element) => {
        const key = element.getAttribute("data-i18n-placeholder");
        if (key && dictionary[key]) {
          element.setAttribute("placeholder", dictionary[key]);
        }
      });

      heroChatSuggestions.forEach((button) => {
        const suggestion = button.getAttribute(
          language === "pt"
            ? "data-chat-suggestion-pt"
            : "data-chat-suggestion-en"
        );

        if (suggestion) {
          button.setAttribute("data-chat-suggestion", suggestion);
        }
      });

      languageOptions.forEach((option) => {
        option.setAttribute(
          "aria-pressed",
          String(option.getAttribute("data-language-option") === language)
        );
      });

      if (languageSwitch) {
        languageSwitch.setAttribute("aria-label", dictionary["language.label"]);
      }

      localStorage.setItem("site-language", language);
      setMenuOpen(isMenuOpen());
    }

    function createAssistantShell({ loading = false } = {}) {
      const row = document.createElement("div");
      row.className = "hero-chat-response-row";

      const avatar = document.createElement("div");
      avatar.className = "hero-chat-avatar";
      avatar.setAttribute("aria-hidden", "true");
      avatar.innerHTML = `<dotlottie-player src="/animations/orb.lottie" background="transparent" speed="1" loop${
        prefersReducedMotion ? "" : " autoplay"
      }></dotlottie-player>`;
      const player = avatar.querySelector("dotlottie-player");

      const response = document.createElement("article");
      response.className = "hero-chat-response";
      if (loading) response.classList.add("hero-chat-response-loading");

      const heading = document.createElement("div");
      heading.className = "hero-chat-response-heading";

      const name = document.createElement("strong");
      name.textContent = translate("chat.assistantName");
      heading.appendChild(name);

      const answer = document.createElement("p");
      answer.textContent = loading ? translate("chat.loading") : "";

      if (loading) {
        const typing = document.createElement("span");
        typing.className = "hero-chat-typing";
        typing.setAttribute("aria-hidden", "true");
        typing.append(
          document.createElement("span"),
          document.createElement("span"),
          document.createElement("span")
        );
        answer.appendChild(typing);
      }

      const cards = document.createElement("div");
      cards.className = "hero-chat-projects";

      const links = document.createElement("div");
      links.className = "hero-chat-response-links";

      response.append(heading, answer, cards, links);
      row.append(avatar, response);

      return { row, response, answer, cards, links, player };
    }

    function appendUserMessage(question) {
      if (!heroChatHistory) return;

      const row = document.createElement("div");
      row.className = "hero-chat-user-row";

      const bubble = document.createElement("article");
      bubble.className = "hero-chat-user-message";

      const heading = document.createElement("strong");
      heading.className = "visually-hidden";
      heading.textContent = translate("chat.you");

      const text = document.createElement("p");
      text.textContent = question;

      bubble.append(heading, text);
      row.appendChild(bubble);
      heroChatHistory.appendChild(row);
    }

    function setChatLoading() {
      if (!heroChatHistory) return null;

      const shell = createAssistantShell({ loading: true });
      heroChatHistory.appendChild(shell.row);
      heroChatHistory.setAttribute("aria-busy", "true");
      shell.row.scrollIntoView({
        block: "end",
        behavior: prefersReducedMotion ? "auto" : "smooth",
      });

      heroChatSubmit?.setAttribute("disabled", "");
      heroChatSuggestions.forEach((button) => {
        button.setAttribute("disabled", "");
      });

      return shell;
    }

    function renderProjectCards(cardsContainer, links = []) {
      cardsContainer.replaceChildren();

      links.forEach((link) => {
        const preview = projectPreviews[link.href];
        if (!preview) return;

        const card = document.createElement("a");
        card.className = "hero-chat-project-card";
        card.href = link.href;

        const image = document.createElement("img");
        image.src = preview.image;
        image.alt = "";
        image.loading = "lazy";
        image.decoding = "async";
        image.width = 80;
        image.height = 60;

        const content = document.createElement("span");

        const title = document.createElement("strong");
        title.textContent = preview.title;

        const category = document.createElement("span");
        category.textContent = preview.category;

        content.append(title, category);
        card.append(image, content);
        cardsContainer.appendChild(card);
      });
    }

    // Freeze an answer's avatar once it is done, so only the pending
    // answer animates instead of one loop per message.
    function stopAvatar(player) {
      if (!player) return;

      const pause = () => {
        try {
          player.pause?.();
        } catch {}
      };

      player.removeAttribute("autoplay");
      pause();
      player.addEventListener("ready", pause, { once: true });
    }

    function renderChatAnswer(shell, response) {
      if (!shell) return;

      shell.answer.textContent = response.answer;

      if (response.language) {
        const lang = response.language === "pt" ? "pt-BR" : "en";
        shell.response.lang = lang;
        shell.row.previousElementSibling?.setAttribute("lang", lang);
      }
      shell.answer.classList.add("hero-chat-answer-in");
      shell.links.replaceChildren();
      renderProjectCards(shell.cards, response.links);

      // A project with a card already has a way in; skip its duplicate pill.
      response.links?.forEach((link) => {
        if (projectPreviews[link.href]) return;

        const element = document.createElement("a");
        element.className = "hero-chat-response-link";
        element.textContent = link.label;
        element.href = link.href;

        if (link.href?.startsWith("http")) {
          element.target = "_blank";
          element.rel = "noreferrer";
        }

        shell.links.appendChild(element);
      });

      shell.response.classList.remove("hero-chat-response-loading");
      stopAvatar(shell.player);
      heroChatHistory?.removeAttribute("aria-busy");

      if (shell.row.isConnected) {
        (shell.row.previousElementSibling ?? shell.row).scrollIntoView({
          block: "start",
          behavior: prefersReducedMotion ? "auto" : "smooth",
        });
      }

      heroChatSubmit?.removeAttribute("disabled");
      heroChatSuggestions.forEach((button) => {
        button.removeAttribute("disabled");
      });
    }

    function renderChatError(shell, message) {
      renderChatAnswer(shell, {
        answer: message || translate("chat.error"),
        links: [
          { label: translate("chat.emailBruno"), href: "mailto:contact@brunoux.com" },
          { label: translate("chat.viewWork"), href: "/#projects" },
        ],
      });
    }

    async function showChatAnswer(question) {
      heroOrb?.classList.add("hero-orb-hidden");
      heroChatIntro?.classList.add("hero-chat-intro-hidden");
      chatPage?.classList.add("is-chatting");
      if (chatReset) chatReset.hidden = false;
      appendUserMessage(question);
      const shell = setChatLoading();

      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ message: question }),
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => null);
          renderChatError(shell, errorData?.error);
          return;
        }

        const data = await response.json();
        renderChatAnswer(shell, data);
      } catch (error) {
        console.error("Portfolio assistant error", error);
        renderChatError(shell);
      }
    }

    const savedLanguage = localStorage.getItem("site-language") || "en";
    applyLanguage(savedLanguage);

    languageOptions.forEach((option) => {
      option.addEventListener("click", () => {
        applyLanguage(option.getAttribute("data-language-option"));
      });
    });

    function resetConversation() {
      heroChatHistory?.replaceChildren();
      heroChatHistory?.removeAttribute("aria-busy");
      heroOrb?.classList.remove("hero-orb-hidden");
      heroChatIntro?.classList.remove("hero-chat-intro-hidden");
      chatPage?.classList.remove("is-chatting");
      if (chatReset) chatReset.hidden = true;
      window.scrollTo({ top: 0 });
      heroChatInput?.focus({ preventScroll: true });
    }

    chatReset?.addEventListener("click", resetConversation);

    function isMenuOpen() {
      return menuToggle?.getAttribute("aria-expanded") === "true";
    }

    function setMenuOpen(isOpen) {
      if (!menuToggle || !mobileMenu) return;
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute(
        "aria-label",
        translate(isOpen ? "menu.close" : "menu.open")
      );
      mobileMenu.hidden = !isOpen;
    }

    menuToggle?.addEventListener("click", () => {
      setMenuOpen(!isMenuOpen());
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isMenuOpen()) {
        setMenuOpen(false);
        menuToggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (
        isMenuOpen() &&
        !mobileMenu.contains(event.target) &&
        !menuToggle.contains(event.target)
      ) {
        setMenuOpen(false);
      }
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    heroChatForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const question = heroChatInput?.value.trim();
      if (question) {
        heroChatInput.value = "";
        showChatAnswer(question);
      }
    });

    heroChatSuggestions.forEach((button) => {
      button.addEventListener("click", () => {
        const question = button.getAttribute("data-chat-suggestion");
        if (!question) return;
        showChatAnswer(question);

        // Keep keyboard and mouse users in the input; on touch this would
        // pop the keyboard over the answer.
        if (hasFinePointer) {
          heroChatInput?.focus({ preventScroll: true });
        }
      });
    });
  </script>
</BaseLayout>
