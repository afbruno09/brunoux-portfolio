---
import ProjectCase from "../../layouts/ProjectCase.astro";

const figmaFileUrl =
  "https://www.figma.com/design/fDDMxTuLowUBqhodkOqYDU/An%C3%A1lise-de-Risco-App?node-id=380-8093";

const project = {
  title: "Comgás Field Safety App",
  client: "Comgás",
  year: "2024–2025",
  role: "Product Designer",
  platform: "Mobile app + web dashboard",
  summary:
    "A digital safety workflow designed to replace paper-based field forms, helping technicians document operational risks and enabling office teams to review evidence with more clarity.",

  heroImage: "/images/comgas/cover-opt.jpg",
  heroAlt: "Comgás field safety app case study cover",
  hideOverview: true,

  challenge: [
    "Field technicians relied on paper forms to register risks — slow, hard to review, easy to lose.",
  ],

  solution: [],

  sections: [
    {
      id: "scan",
      kind: "scan",
      eyebrow: "30-second read",
      scanItems: [
        {
          title: "Problem",
          body: "Field technicians relied on paper forms to register risks — slow, hard to review, easy to lose.",
        },
        {
          title: "Role",
          body: "UX/UI + field research — visited operations sites to see the paper workflow firsthand.",
        },
        {
          title: "What changed",
          bullets: [
            "Paper checklist became a guided mobile flow",
            "Photo/video evidence attached directly on site",
            "Office dashboard for review, not another spreadsheet",
          ],
        },
        {
          title: "Outcome",
          body: "Working mobile + dashboard prototype, tested against the real paper-form workflow.",
        },
      ],
    },

    {
      id: "field-research",
      eyebrow: "Field research",
      title: "Starting from the paper forms technicians actually use",
      layout: "text-first",
      imageColumns: 3,
      content: [
        "Before any screen, I went to a Comgás field site to see the process end to end — the printed \"PT\" (permissão de trabalho) form technicians fill by hand, and the risk-analysis checklist used before starting a task. Digitizing without seeing this would have missed how much of it happens standing up, outdoors, under time pressure.",
      ],
      images: [
        {
          src: "/images/comgas/paper-pt-form.png",
          alt: "Printed work permit form for work at height, filled by hand in the field",
          caption: "Paper PT form — handwritten in the field",
        },
        {
          src: "/images/comgas/risk-checklist-opt.jpg",
          alt: "Printed Comgás risk-analysis checklist",
          caption: "Printed risk-analysis checklist",
        },
        {
          src: "/images/comgas/field-visit-opt.jpg",
          alt: "Comgás field crew on site with a pipe-testing warning sign",
          caption: "On-site field visit",
        },
      ],
    },

    {
      id: "prototype",
      kind: "embed",
      eyebrow: "Evidence — live prototype",
      title: "The real Figma file — flows, components, delivery",
      content: [
        "Embedding the actual \"Análise de Risco App\" file instead of another static summary — the full risk-analysis flow, the work-at-height flow, and the refined delivery components for EPIs.",
      ],
      embedUrl: `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(figmaFileUrl)}`,
      embedTitle: "Análise de Risco App — Figma prototype",
      ctaHref: figmaFileUrl,
      ctaLabel: "Open the Figma file ↗",
    },

    {
      id: "risk-registration",
      eyebrow: "Risk registration",
      title: "Turning the paper checklist into a guided flow",
      layout: "text-first",
      content: [
        "The interface walks technicians through the same questions as the paper form — type of activity, depth, location, risk level — one at a time, so nothing gets skipped under time pressure, and the office team gets a structured submission instead of a scanned sheet.",
      ],
      image: {
        src: "/images/comgas/risk-registration-opt.jpg",
        alt: "Risk registration flow in the Comgás mobile app",
      },
    },

    {
      id: "evidence",
      eyebrow: "Evidence capture",
      title: "Connecting photos and field information",
      layout: "text-first",
      content: [
        "Technicians attach photo or video evidence directly to the risk submission — creating a reliable link between what happened in the field and what the office team reviews, instead of a paper form with no visual record.",
      ],
      image: {
        src: "/images/comgas/evidence-opt.jpg",
        alt: "Evidence capture screens with photos and videos",
      },
      imageMaxWidth: "900px",
    },

    {
      id: "dashboard",
      eyebrow: "Web dashboard",
      title: "Supporting review from the office",
      layout: "text-first",
      content: [
        "The dashboard concept brings submitted reports, evidence, status, location and operational data together for managers — replacing scattered paper and spreadsheets with one review environment.",
      ],
      image: {
        src: "/images/comgas/dashboard-opt.jpg",
        alt: "Comgás web dashboard for reviewing field safety reports",
      },
    },

    {
      id: "mobile",
      eyebrow: "Mobile-first design",
      title: "A compact interface for fast field use",
      layout: "text-first",
      content: [
        "Screens stay focused — short forms, clear labels, visible progress — so a technician can complete the process outdoors without unnecessary friction.",
      ],
      image: {
        src: "/images/comgas/mobile-opt.jpg",
        alt: "Mobile screens of the Comgás field safety app",
      },
    },

    {
      id: "outcome",
      kind: "checklist",
      eyebrow: "Outcome",
      title: "A clearer operational safety workflow",
      content: [
        "The prototype translated a paper-based field documentation process into a structured digital workflow, connecting technicians and office teams around the same submission — from the handwritten form to a reviewable record.",
      ],
      checklistItems: [
        "Prototype built end-to-end: mobile risk flow + web dashboard concept",
        "Grounded in a real field visit and the actual paper forms in use",
        "Structured submission replaces a scanned, handwritten sheet",
      ],
    },
  ],

  nextProject: {
    title: "Doutor Já",
    href: "/work/doutor-ja",
  },
};
---

<ProjectCase project={project} />
