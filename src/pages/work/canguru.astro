---
import ProjectCase from "../../layouts/ProjectCase.astro";

const project = {
  title: "Canguru — Pregnancy App",
  client: "Canguru",
  year: "2018",
  role: "Freelance UX Designer (team project)",
  platform: "Mobile app",
  accentColor: "#c2287d",
  summary:
    "How to make a friendly first contact with expecting mothers and sustain engagement through postpartum, in a moment marked by fear and misinformation.",

  heroImage: "/images/canguru/hero-app-opt.jpg",
  heroAlt: "Canguru pregnancy app on two phones",
  heroImageMaxWidth: "420px",
  hideOverview: true,

  challenge: [
    "How to make a friendly first contact and sustain engagement through pregnancy until postpartum?",
  ],

  solution: [],

  sections: [
    {
      id: "context",
      kind: "stats",
      eyebrow: "Context & problem",
      title: "Fighting pregnancy risks with information",
      content: [
        "Canguru is a pregnancy-monitoring app built to reduce the risks of a delicate moment — violence and medical abuse, household accidents, and unfounded beliefs that can cause complications during pregnancy.",
        "Its answer is information, both from mother to mother and from health professionals. The challenge was how to make a friendly first contact and keep mothers engaged from pregnancy through postpartum. The Brazilian obstetric scenario:",
      ],
      stats: [
        { value: "97%", label: "receive prenatal care" },
        { value: "1k", label: "maternal deaths from direct obstetric causes" },
        { value: "18k", label: "deaths prevented by care during pregnancy" },
      ],
      statsSource:
        "Source: IBGE — National Health Survey 2013; Mortality Information 2017",
    },

    {
      id: "research",
      kind: "stats",
      eyebrow: "Research",
      title: "Listening to mothers, non-users and the medical team",
      content: [
        "Across four interview and usability-testing sessions, we heard from 74 people. The interviews revealed three recurring pain points: lack of clarity about their own bodies, difficulty finding reliable information, and a desire for direct contact with health professionals — not just a forum among users.",
      ],
      stats: [
        { value: "57", label: "users interviewed" },
        { value: "15", label: "non-users of the app" },
        { value: "2", label: "members of the medical team" },
      ],
      image: {
        src: "/images/canguru/personas-opt.jpg",
        alt: "Three personas built from the interviews: Jussara, Natália and Célia",
      },
    },

    {
      id: "key-decisions",
      eyebrow: "Key decisions",
      title: "The forum was the problem",
      layout: "text-first",
      content: [
        "The full journey map (Knowing → Starting → Using → Developing → Leaving) showed the app revolved too much around the forum — the only source of information was other users' opinions, with no distinction for who was a health professional.",
        "That hurt credibility and relevance, and became the problem behind the decisions below: separate medical guidance from informal conversation, and give mothers a reference space about their own bodies. Three criteria guided every choice:",
      ],
      tags: ["Credibility", "Relevance", "Engagement"],
      image: {
        src: "/images/canguru/journey-map.png",
        alt: "Journey map across the Knowing, Starting, Using, Developing and Leaving stages",
      },
      imageMaxWidth: "900px",
    },

    {
      id: "process",
      eyebrow: "Process",
      title: "Paper wireframes and usability testing",
      layout: "text-first",
      images: [
        {
          src: "/images/canguru/paper-wireframes.png",
          alt: "Paper wireframes and sticky-note flows",
          caption: "Paper wireframes",
        },
        {
          src: "/images/canguru/usability-tests-opt.jpg",
          alt: "Usability testing sessions with users holding the prototype",
          caption: "Usability testing with users",
        },
      ],
    },

    {
      id: "solution",
      kind: "cards",
      eyebrow: "Solution — what was delivered",
      title: "Each screen answers one criterion",
      cards: [
        {
          title: "Mom's area",
          body: "Answers the recurring body-related questions raised in research — criterion: credibility.",
          image: {
            src: "/images/canguru/mom-area.png",
            alt: "Mom's area screen",
          },
        },
        {
          title: "Forum (redesigned)",
          body: "Flags health professionals' replies to set them apart from layperson opinion — a direct answer to the forum problem above — criterion: credibility + relevance.",
          image: {
            src: "/images/canguru/forum.png",
            alt: "Redesigned forum screen",
          },
        },
        {
          title: "Baby's area",
          body: "A \"milestones\" system for fetal development becomes the home screen — criterion: engagement.",
          image: {
            src: "/images/canguru/baby-area.png",
            alt: "Baby's area screen with a development milestone",
          },
        },
        {
          title: "Progressive form",
          body: "Asks for data gradually, after value is delivered — criterion: relevance.",
          image: {
            src: "/images/canguru/progressive-form.png",
            alt: "Progressive form screen asking for data after value is delivered",
          },
        },
      ],
    },

    {
      id: "prototype-video",
      eyebrow: "Prototype video",
      title: "Animated walkthrough of the final prototype",
      youtubeUrl: "https://www.youtube.com/embed/pNYIWjm0ywA",
    },

    {
      id: "reflection",
      eyebrow: "Reflection",
      title: "The reasoning is the result",
      layout: "text-first",
      content: [
        "The prototype was tested with users in usability rounds; it never reached development, so there is no results section here — the value of this case is the reasoning behind each decision, not post-launch metrics.",
        "74 people heard across four interview and usability-testing sessions (57 users, 15 non-users, 2 from the app's medical team), wireframes tested with users, and design decisions tied to explicit criteria — credibility, relevance, engagement — rather than aesthetic preference. That reasoning, problem → research → criterion → decision, is what this team project demonstrates.",
        "What I'd do differently today: the forum still carries too much weight in the experience even after the redesign — I'd want to test whether the specialist chat should be the primary entry point rather than one tab among others. And the \"milestones\" system in the baby's area was a good engagement idea that was never tested with a real user for long enough to know if it holds up past the first week of use.",
      ],
    },
  ],

  nextProject: {
    title: "World Bank / Ministry of Labor",
    href: "/work/world-bank",
  },
};
---

<ProjectCase project={project} />
