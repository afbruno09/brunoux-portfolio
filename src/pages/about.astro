---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Bruno Amorim">
  <section class="about-page">

<section class="about-page">
  <!-- HERO -->
  <section class="about-hero">
    <video
  class="about-hero-video"
  autoplay
  muted
  loop
  playsinline
  preload="metadata"
  
>
  <source
    src="/videos/about-hero-mobile.mp4"
    type="video/mp4"
    media="(max-width: 767px)"
  />
  <source
    src="/videos/about-hero-desktop.mp4"
    type="video/mp4"
    media="(min-width: 768px)"
  />
</video>

    <div class="about-hero-overlay"></div>

    <div class="about-hero-content">
      <span class="eyebrow">About</span>

      <h1>
        Designing digital products with clarity, strategy and purpose.
      </h1>

      <p>
        I’m Bruno Amorim, a Product Designer focused on creating useful,
        scalable and human-centered digital experiences.
      </p>
    </div>
  </section>

  <!-- INTRO -->
  <section class="about-section about-intro">
    <div class="section-label">
      <span>01</span>
      <p>Profile</p>
    </div>

    <div class="section-content">
      <h2>
        I work across research, strategy, interface design and product thinking.
      </h2>

      <p>
        Over the past 8+ years, I’ve designed digital products for startups,
        consultancies and large organizations across fintech, healthcare,
        energy, public services, data platforms and emerging technologies.
      </p>

      <p>
        My work usually happens between user needs, business goals and technical
        constraints. I help teams turn complex problems into clear flows,
        structured interfaces and digital products that can evolve over time.
      </p>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="about-section">
    <div class="section-label">
      <span>02</span>
      <p>How I work</p>
    </div>

    <div class="section-content">
      <div class="work-grid">
        <article class="work-card">
          <span>01</span>
          <h3>Understand the problem</h3>
          <p>
            I start by mapping context, users, goals and constraints before
            moving into solutions.
          </p>
        </article>

        <article class="work-card">
          <span>02</span>
          <h3>Design with clarity</h3>
          <p>
            I create flows, wireframes and interfaces that reduce friction and
            make decisions easier.
          </p>
        </article>

        <article class="work-card">
          <span>03</span>
          <h3>Prototype and validate</h3>
          <p>
            I use prototypes, feedback and product signals to refine the
            experience before and after delivery.
          </p>
        </article>

        <article class="work-card">
          <span>04</span>
          <h3>Collaborate with teams</h3>
          <p>
            I work closely with product managers, developers and stakeholders to
            keep design decisions feasible and aligned.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="about-section">
    <div class="section-label">
      <span>03</span>
      <p>Experience</p>
    </div>

    <div class="section-content">
      <h2>
        Selected areas where I’ve helped teams design better products.
      </h2>

      <div class="experience-list">
        <article class="experience-item">
          <h3>World Bank / Ministry of Labor</h3>
          <p>
            UX work for a labor market information system designed to support
            public employment services, career guidance and labor intelligence.
          </p>
        </article>

        <article class="experience-item">
          <h3>Field operations and safety tools</h3>
          <p>
            Mobile and web interfaces for operational teams, documentation
            workflows and safety-related processes in field environments.
          </p>
        </article>

        <article class="experience-item">
          <h3>Fintech and banking products</h3>
          <p>
            Digital banking interfaces, transaction flows, internal tools and
            design system evolution for financial products.
          </p>
        </article>

        <article class="experience-item">
          <h3>Startups and early-stage products</h3>
          <p>
            Product discovery, MVP design, branding, websites and scalable
            interface foundations for products moving from idea to market.
          </p>
        </article>
      </div>
    </div>
  </section>

 <!-- EDUCATION -->
<section class="about-section">
  <div class="section-label">
    <span>04</span>
    <p>Education</p>
  </div>

  <div class="section-content">
    <h2>
      A background that connects art, design, technology and product strategy.
    </h2>

    <div class="education-list">
      <article class="education-item">
        <span>Degree</span>
        <h3>Bachelor’s Degree in Arts and Design</h3>
        <p>Federal University of Juiz de Fora — UFJF</p>
      </article>

      <article class="education-item">
        <span>Master’s Degree</span>
        <h3>Master’s student in Intelligence Technologies and Digital Design</h3>
        <p>Pontifical Catholic University of São Paulo — PUC-SP</p>
      </article>

      <article class="education-item">
        <span>Specialization</span>
        <h3>UX Design</h3>
        <p>TERA</p>
      </article>

      <article class="education-item">
        <span>Specialization</span>
        <h3>Digital Product Leadership</h3>
        <p>TERA</p>
      </article>

      <article class="education-item">
        <span>Specialization</span>
        <h3>Service Design</h3>
        <p>Professional certification</p>
      </article>

      <article class="education-item">
        <span>Language Certification</span>
        <h3>English Proficiency — C2</h3>
        <p>Certified professional English proficiency</p>
      </article>
    </div>

    <a href="#certificates" class="certificates-link">
      View certificates
    </a>
  </div>
</section>

  <!-- BEYOND DESIGN -->
  <section class="about-section about-beyond">
    <div class="section-label">
      <span>04</span>
      <p>Beyond design</p>
    </div>

    <div class="section-content">
      <h2>
        I’m interested in the intersection between design, technology, behavior
        and culture.
      </h2>

      <p>
        My background combines product design, visual systems, research and a
        growing technical interest in front-end development and artificial
        intelligence. I believe designers can contribute more when they
        understand not only the interface, but also the system behind it.
      </p>

      <p>
        This is also why I’m rebuilding my own portfolio in code: to have more
        control over structure, performance, interaction and future evolution.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div>
      <span class="eyebrow">Let’s talk</span>
      <h2>Want to build something clear, useful and scalable?</h2>
    </div>

    <div class="about-cta-actions">
      <a href="/contact" class="primary-button">Get in touch</a>
      <a href="/" class="secondary-button">Home</a>
    </div>
  </section>
</section>

<style>
  .about-page {
    background: #f7f4ef;
    color: #171717;
  }

  /* HERO */

  .about-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 120px 24px 80px;
    background: #111;
  }

  .about-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    z-index: 0;
  }

  .about-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.22),
        rgba(0, 0, 0, 0.78)
      );
  }

  .about-hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 860px;
    color: #fff;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .about-hero-content h1 {
    margin: 0 auto 20px;
    max-width: 860px;
    font-size: clamp(2.4rem, 6.4vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .about-hero-content p {
    max-width: 620px;
    margin: 0 auto;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    opacity: 0.88;
  }

  /* SECTIONS */

  .about-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 72px 24px;
    border-bottom: 1px solid rgba(23, 23, 23, 0.12);
  }

  .section-label {
    display: flex;
    gap: 12px;
    align-items: center;
    color: rgba(23, 23, 23, 0.58);
  }

  .section-label span,
  .section-label p {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-content {
    max-width: 900px;
  }

  .section-content h2 {
    margin: 0 0 24px;
    max-width: 820px;
    font-size: clamp(2rem, 5vw, 4.2rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .section-content p {
    max-width: 720px;
    margin: 0 0 18px;
    color: rgba(23, 23, 23, 0.72);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* HOW I WORK */

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 16px;
  }

  .work-card {
    padding: 24px;
    border: 1px solid rgba(23, 23, 23, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.45);
  }

  .work-card span {
    display: inline-block;
    margin-bottom: 40px;
    color: rgba(23, 23, 23, 0.45);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .work-card h3 {
    margin: 0 0 12px;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
  }

  .work-card p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* EXPERIENCE */

  .experience-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-top: 32px;
    border-top: 1px solid rgba(23, 23, 23, 0.12);
  }

  .experience-item {
    padding: 28px 0;
    border-bottom: 1px solid rgba(23, 23, 23, 0.12);
  }

  .experience-item h3 {
    margin: 0 0 10px;
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .experience-item p {
    margin: 0;
  }

/* EDUCATION */

.education-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  margin-top: 32px;
}

.education-item {
  padding: 24px;
  border: 1px solid rgba(23, 23, 23, 0.12);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.45);
}

.education-item span {
  display: inline-block;
  margin-bottom: 18px;
  color: rgba(23, 23, 23, 0.5);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.education-item h3 {
  margin: 0 0 10px;
  font-size: clamp(1.15rem, 2.5vw, 1.6rem);
  line-height: 1.15;
  letter-spacing: -0.035em;
}

.education-item p {
  margin: 0;
  color: rgba(23, 23, 23, 0.68);
  font-size: 0.95rem;
  line-height: 1.55;
}

.certificates-link {
  display: inline-block;
  margin-top: 24px;
  color: #171717;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 4px;
  text-decoration-thickness: 1px;
}

.certificates-link:hover {
  opacity: 0.68;
}

@media screen and (min-width: 768px) {
  .education-list {
    grid-template-columns: repeat(2, 1fr);
  }
.certificates-link {
  display: block;
  width: fit-content;
  margin: 24px auto 0;
  text-align: center;
}

}

  /* CTA */

  .about-cta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 72px 24px;
    background: #171717;
    color: #fff;
  }

  .about-cta h2 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .about-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 180ms ease,
      opacity 180ms ease,
      background 180ms ease;
  }

  .primary-button {
    background: #fff;
    color: #171717;
  }

  .secondary-button {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #fff;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);
  }

  /* MOBILE */

  @media screen and (max-width: 900px) {
    .about-hero {
  min-height: 50vh;
  height: 50vh;
  padding: 72px 20px 32px;
  box-sizing: border-box;
  
    }

    .about-hero-content {
      max-width: 340px;
    }

    .about-hero-content h1 {
      max-width: 330px;
      font-size: clamp(1rem, 5vw, 1.6rem);
      line-height: 1;
      letter-spacing: -0.045em;
      margin-bottom: 14px;
    }

    .about-hero-content p {
      max-width: 310px;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .eyebrow {
      margin-bottom: 10px;
      font-size: 0.68rem;
    }

    .about-section {
      padding: 64px 20px;
    }

    .work-grid {
      gap: 12px;
    }

    .work-card {
      padding: 20px;
      border-radius: 20px;
    }

    .work-card span {
      margin-bottom: 28px;
    }

    .about-cta {
      padding: 64px 20px;
    }
  }

  /* TABLET / DESKTOP */

  @media screen and (min-width: 768px) {
    .about-hero {
      padding: 140px 48px 72px;
    }

    .about-section {
      grid-template-columns: 180px 1fr;
      gap: 56px;
      padding: 96px 48px;
    }

    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-cta {
      grid-template-columns: 1fr auto;
      align-items: end;
      padding: 96px 48px;
    }

    .about-cta-actions {
      min-width: 220px;
    }
  }

  @media screen and (min-width: 1180px) {
    .about-hero {
      padding-left: 72px;
      padding-right: 72px;
    }

    .about-section {
      padding-left: 72px;
      padding-right: 72px;
    }

    .about-cta {
      padding-left: 72px;
      padding-right: 72px;
    }
  }

  /* ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {
    .about-hero-video {
      display: none;
    }

    .about-hero {
      background:
        linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.25),
          rgba(0, 0, 0, 0.8)
        ),
        #111;
    }

    .primary-button,
    .secondary-button {
      transition: none;
    }

    .primary-button:hover,
    .secondary-button:hover {
      transform: none;
    }
  }
</style>
</BaseLayout>